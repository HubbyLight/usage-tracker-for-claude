{
  "name": "claude-usage-tracker",
  "version": "0.2.7",
  "description": "Tray / menu-bar app that tracks your Claude.ai 5-hour and weekly usage at a glance",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "sync-install": "node scripts/sync-install.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.claudeusage.tracker",
    "productName": "Claude Usage",
    "win": {
      "target": "portable",
      "icon": "icon-256.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "icon": "icon-512.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  }
}
